DATABASE_URL=postgres://user:password@localhost:5432/domtrack
DATABASE_SSL=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USERNAME=
DOMTRACK_BASE_URL=https://domtrack.ru
DOMTRACK_UPLOAD_DIR=/var/lib/domtrack/photos

# OLNOO CRM lead sync (lib/crm-sync.ts): after a Telegram order is saved in DomTrack's own
# database, a commercial-context lead is sent to POST <OLNOO_CRM_URL>/api/leads/inbound in
# olnoo-admin (project=domtrack). Server-only — never exposed to the browser, never in
# NEXT_PUBLIC_*. OLNOO_CRM_URL must be the CRM's origin only (https, no userinfo/query/hash);
# crm-sync.ts appends /api/leads/inbound itself. OLNOO_CRM_API_KEY must match OLNOO_CRM_API_KEY in
# olnoo-admin's own env (sent as "Authorization: Bearer <key>"). Missing either one just skips the
# CRM sync (logged) — the DomTrack order itself always saves regardless.
OLNOO_CRM_URL=https://admin.olnoo.com
OLNOO_CRM_API_KEY=
